{
  "ConnectionStrings": {
    "SqlDb": "Server=<sql-host>;Database=<db>;User Id=<user>;Password=<password>;TrustServerCertificate=true",
    "MongoDb": "mongodb://localhost:27017/",
    "MongoDbs": "mongodb://mongo4:27017,mongo5:27017,mongo6:27017/?replicaSet=rs0"
  },
  "MessageBroker": {
    "Type": "RabbitMQ", //  "Kafka" or "RabbitMQ"
    "Library": "MassTransit", //  "CAP" or "MassTransit"
    "RabbitMQ": {
      "Exchange": "MessageHub",
      "Host": "localhost",
      "Username": "guest",
      "Password": "guest",
      "VirtualHost": "/"
    },
    "Kafka": {
      "BootstrapServers": "kafka:9092",
      "GroupId": "email-sender"
    }
  },
  "SmtpSettings": {
    "FromEmail": "noreply@example.com",
    "FromName": "MessageHub",
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "user",
    "Password": "password",
    "EnableSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "runtimeOptions": {
    "configProperties": {
      "System.Globalization.Invariant": false
    }
  }
}